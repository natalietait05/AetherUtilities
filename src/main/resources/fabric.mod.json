{
  "schemaVersion": 1,
  "id": "aetherutilities",
  "version": "${version}",
  "name": "AetherUtilities",
  "description": "A collection of client-side utility features.",
  "authors": ["Aetheris"],
  "contact": {
    "sources": "https://github.com/natalietait05/AetherUtilities"
  },
  "license": "MIT",
  "icon": "assets/aetherutilities/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.aetheris.aetherutilities.AetherUtilities"],
    "client": ["com.aetheris.aetherutilities.client.AetherUtilitiesClient"]
  },
  "mixins": [
    {
      "config": "aetherutilities.mixins.json"
    },
    {
      "config": "aetherutilities.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
